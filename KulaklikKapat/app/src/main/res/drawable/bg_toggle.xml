<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <solid android:color="@color/primary" />
                    <stroke android:width="6dp" android:color="@color/primary_soft" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/toggle_off" />
                    <stroke android:width="3dp" android:color="@color/primary" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

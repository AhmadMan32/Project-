<?xml version="1.0" encoding="utf-8"?>
<!-- the TV button: blue while the remote is open -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/panel_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/panel_accent" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/panel_key" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

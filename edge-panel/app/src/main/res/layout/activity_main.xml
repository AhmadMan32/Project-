<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- State -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/state_title"
                style="@style/CardTitle"
                android:layout_marginBottom="4dp"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/toggle"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Handle -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/handle_title" />

            <TextView
                style="@style/OptionDesc"
                android:text="@string/handle_hint" />

            <TextView
                style="@style/Label"
                android:text="@string/side" />

            <LinearLayout
                android:id="@+id/seg_side"
                style="@style/SegmentGroup" />

            <TextView
                android:id="@+id/length_label"
                style="@style/Label" />

            <SeekBar
                android:id="@+id/length"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/thickness_label"
                style="@style/Label" />

            <SeekBar
                android:id="@+id/thickness"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/opacity_label"
                style="@style/Label" />

            <SeekBar
                android:id="@+id/opacity"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <Switch
                android:id="@+id/opt_locked"
                style="@style/Option"
                android:layout_marginTop="6dp"
                android:text="@string/opt_locked" />

            <TextView
                android:id="@+id/reset_position"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="@string/reset_position" />
        </LinearLayout>

        <!-- Apps -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/apps_card" />

                <TextView
                    android:id="@+id/apps_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/apps_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/choose_apps"
                style="@style/OutlineButton"
                android:layout_marginTop="14dp"
                android:text="@string/choose_apps" />
        </LinearLayout>

        <!-- TV remote -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/tv_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ir_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/ir_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:text="@string/brand" />

            <LinearLayout
                android:id="@+id/seg_brand"
                style="@style/SegmentGroup" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/test_power"
                    style="@style/OutlineButton"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/test_power" />

                <TextView
                    android:id="@+id/find_brand"
                    style="@style/OutlineButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/find_brand" />
            </LinearLayout>

            <TextView
                style="@style/OptionDesc"
                android:layout_marginTop="10dp"
                android:text="@string/tv_hint" />

            <Switch
                android:id="@+id/opt_digits"
                style="@style/Option"
                android:layout_marginTop="6dp"
                android:text="@string/opt_digits" />

            <Switch
                android:id="@+id/opt_haptics"
                style="@style/Option"
                android:text="@string/opt_haptics" />

            <Switch
                android:id="@+id/opt_boot"
                style="@style/Option"
                android:text="@string/opt_boot" />
        </LinearLayout>

        <!-- Permissions -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:layout_marginBottom="0dp"
                android:text="@string/perm_title" />

            <LinearLayout
                android:id="@+id/permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/footer"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

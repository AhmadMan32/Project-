<?xml version="1.0" encoding="utf-8"?>
<com.ahmadman.kenarpanel.PanelRoot xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_dim"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- App shortcuts -->
        <LinearLayout
            android:id="@+id/apps_card"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- LG remote: power, HDMI 1, HDMI 2 -->
        <LinearLayout
            android:id="@+id/remote_card"
            android:layout_width="236dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/remote_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- which TV: LG (infrared) or Android TV (Wi-Fi) -->
                <LinearLayout
                    android:id="@+id/tv_switch"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_switch"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/tab_lg"
                        style="@style/TvTab"
                        android:text="@string/remote_title" />

                    <TextView
                        android:id="@+id/tab_atv"
                        style="@style/TvTab"
                        android:text="@string/tab_atv" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings"
                    android:padding="7dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/panel_text_dim" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- LG page: its size is the size of both pages -->
                <LinearLayout
                    android:id="@+id/page_lg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ir_missing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/ir_missing_panel"
                        android:textColor="@color/panel_power_pressed"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/k_power"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_power"
                        android:clickable="true"
                        android:contentDescription="@string/key_power"
                        android:focusable="true"
                        android:padding="22dp"
                        android:src="@drawable/ic_power"
                        android:tint="@color/panel_text" />

                    <TextView
                        android:id="@+id/power_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:text="@string/power_label"
                        android:textColor="@color/panel_text_dim"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/hdmi_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/k_hdmi1"
                            style="@style/HdmiKey"
                            android:layout_marginEnd="10dp"
                            android:text="@string/key_hdmi1" />

                        <TextView
                            android:id="@+id/k_hdmi2"
                            style="@style/HdmiKey"
                            android:text="@string/key_hdmi2" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Android TV page: same box as the LG page -->
                <LinearLayout
                    android:id="@+id/page_atv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/atv_top"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/atv_chip"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_atv_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:id="@+id/atv_chip_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tv"
                                android:tint="@color/atv_chip_text" />

                            <TextView
                                android:id="@+id/atv_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/atv_chip_text"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/atv_power"
                            style="@style/AtvRound"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:contentDescription="@string/key_power"
                            android:padding="7dp"
                            android:src="@drawable/ic_power" />
                    </LinearLayout>

                    <com.ahmadman.kenarpanel.FillFrame
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1">

                        <com.ahmadman.kenarpanel.TouchpadView
                            android:id="@+id/atv_pad"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:id="@+id/atv_unpaired"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_pad_cover"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/atv_unpaired_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/atv_not_paired_panel"
                                android:textColor="@color/panel_text"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/atv_pair"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_atv_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="@string/atv_pair"
                                android:textColor="@color/panel_atv_on_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.ahmadman.kenarpanel.FillFrame>

                    <LinearLayout
                        android:id="@+id/atv_row1"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/atv_back"
                            style="@style/AtvRound"
                            android:layout_width="46dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/key_back"
                            android:src="@drawable/ic_back" />

                        <ImageView
                            android:id="@+id/atv_home"
                            style="@style/AtvRound"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/key_home"
                            android:src="@drawable/ic_home" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/atv_row2"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/atv_mute"
                            style="@style/AtvRound"
                            android:layout_width="46dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/key_mute"
                            android:src="@drawable/ic_mute" />

                        <ImageView
                            android:id="@+id/atv_vol_down"
                            style="@style/AtvRound"
                            android:layout_width="0dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/key_vol_down"
                            android:src="@drawable/ic_vol_down" />

                        <ImageView
                            android:id="@+id/atv_vol_up"
                            style="@style/AtvRound"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/key_vol_up"
                            android:src="@drawable/ic_vol_up" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- arrow: folds the remote into a small bar, and opens it again -->
            <ImageView
                android:id="@+id/remote_fold"
                android:layout_width="64dp"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_fold"
                android:clickable="true"
                android:contentDescription="@string/remote_hide"
                android:focusable="true"
                android:padding="1dp"
                android:src="@drawable/ic_chevron_up"
                android:tint="@color/panel_text" />
        </LinearLayout>
    </LinearLayout>
</com.ahmadman.kenarpanel.PanelRoot>

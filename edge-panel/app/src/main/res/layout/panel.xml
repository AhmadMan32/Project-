<?xml version="1.0" encoding="utf-8"?>
<com.ahmadman.kenarpanel.PanelRoot xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_dim"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- App shortcuts -->
        <LinearLayout
            android:id="@+id/apps_card"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- TV remote: the card slides under the app column, leaving only the arrow tab -->
        <LinearLayout
            android:id="@+id/remote_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/remote_clip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="UselessParent">

                <!-- music on top, the remote under it: they slide away together -->
                <LinearLayout
                    android:id="@+id/remote_column"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/music_card"
                    android:layout_width="236dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/music_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_music_info"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/music_art"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_music_art"
                            android:importantForAccessibility="no"
                            android:padding="10dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_music"
                            android:tint="@color/panel_text_dim" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/music_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/panel_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/music_artist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/panel_text_dim"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/music_progress"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/music_pos"
                            style="@style/MusicTime" />

                        <SeekBar
                            android:id="@+id/music_seek"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/music_seek"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:progressDrawable="@drawable/music_track"
                            android:splitTrack="false"
                            android:thumb="@drawable/music_thumb" />

                        <TextView
                            android:id="@+id/music_len"
                            style="@style/MusicTime"
                            android:gravity="end|center_vertical" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/music_controls"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/music_prev"
                            style="@style/MusicButton"
                            android:contentDescription="@string/music_previous"
                            android:src="@drawable/ic_skip_prev" />

                        <ImageView
                            android:id="@+id/music_play"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="22dp"
                            android:layout_marginEnd="22dp"
                            android:background="@drawable/bg_music_play"
                            android:clickable="true"
                            android:contentDescription="@string/music_play"
                            android:focusable="true"
                            android:padding="9dp"
                            android:src="@drawable/ic_play"
                            android:tint="@color/on_primary" />

                        <ImageView
                            android:id="@+id/music_next"
                            style="@style/MusicButton"
                            android:contentDescription="@string/music_next"
                            android:src="@drawable/ic_skip_next" />
                    </LinearLayout>

                    <!-- nothing playing, or no access yet: one compact row -->
                    <LinearLayout
                        android:id="@+id/music_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:gravity="center_vertical"
                        android:minHeight="32dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_music"
                            android:tint="@color/panel_text_dim" />

                        <TextView
                            android:id="@+id/music_empty_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:textColor="@color/panel_text_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/music_action"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_music_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/panel_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/remote_body"
                    android:layout_width="236dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/remote_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- which TV: LG (infrared), Android TV (Wi-Fi) or Tivibu (infrared) -->
                        <LinearLayout
                            android:id="@+id/tv_switch"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_switch"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <TextView
                                android:id="@+id/tab_lg"
                                style="@style/TvTab"
                                android:text="@string/remote_title" />

                            <TextView
                                android:id="@+id/tab_atv"
                                style="@style/TvTab"
                                android:layout_weight="1.35"
                                android:text="@string/tab_atv" />

                            <TextView
                                android:id="@+id/tab_tivibu"
                                style="@style/TvTab"
                                android:layout_weight="1.05"
                                android:text="@string/tab_tivibu" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/settings"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/settings"
                            android:padding="7dp"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/panel_text_dim" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/pages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- LG page: its size is the size of both pages -->
                        <LinearLayout
                            android:id="@+id/page_lg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/ir_missing"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/ir_missing_panel"
                                android:textColor="@color/panel_power_pressed"
                                android:textSize="13sp"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/k_power"
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/bg_power"
                                android:clickable="true"
                                android:contentDescription="@string/key_power"
                                android:focusable="true"
                                android:padding="22dp"
                                android:src="@drawable/ic_power"
                                android:tint="@color/panel_text" />

                            <TextView
                                android:id="@+id/power_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="6dp"
                                android:text="@string/power_label"
                                android:textColor="@color/panel_text_dim"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/hdmi_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/k_hdmi1"
                                    style="@style/HdmiKey"
                                    android:layout_marginEnd="10dp"
                                    android:text="@string/key_hdmi1" />

                                <TextView
                                    android:id="@+id/k_hdmi2"
                                    style="@style/HdmiKey"
                                    android:text="@string/key_hdmi2" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Android TV page: same box as the LG page -->
                        <LinearLayout
                            android:id="@+id/page_atv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/atv_top"
                                android:layout_width="match_parent"
                                android:layout_height="30dp"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/atv_chip"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_atv_chip"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp">

                                    <ImageView
                                        android:id="@+id/atv_chip_icon"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_tv"
                                        android:tint="@color/atv_chip_text" />

                                    <TextView
                                        android:id="@+id/atv_name"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textColor="@color/atv_chip_text"
                                        android:textSize="12.5sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/atv_power"
                                    style="@style/AtvRound"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:contentDescription="@string/key_power"
                                    android:padding="7dp"
                                    android:src="@drawable/ic_power" />
                            </LinearLayout>

                            <com.ahmadman.kenarpanel.FillFrame
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="8dp"
                                android:layout_weight="1">

                                <com.ahmadman.kenarpanel.TouchpadView
                                    android:id="@+id/atv_pad"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <LinearLayout
                                    android:id="@+id/atv_unpaired"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_pad_cover"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="6dp"
                                    android:visibility="gone">

                                    <TextView
                                        android:id="@+id/atv_unpaired_text"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:maxLines="2"
                                        android:text="@string/atv_not_paired_panel"
                                        android:textColor="@color/panel_text"
                                        android:textSize="11.5sp" />

                                    <TextView
                                        android:id="@+id/atv_pair"
                                        android:layout_width="wrap_content"
                                        android:layout_height="30dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_atv_button"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center"
                                        android:paddingStart="16dp"
                                        android:paddingEnd="16dp"
                                        android:text="@string/atv_pair"
                                        android:textColor="@color/panel_atv_on_text"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.ahmadman.kenarpanel.FillFrame>

                            <LinearLayout
                                android:id="@+id/atv_row1"
                                android:layout_width="match_parent"
                                android:layout_height="30dp"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/atv_back"
                                    style="@style/AtvRound"
                                    android:layout_width="46dp"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="@string/key_back"
                                    android:src="@drawable/ic_back" />

                                <ImageView
                                    android:id="@+id/atv_home"
                                    style="@style/AtvRound"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@string/key_home"
                                    android:src="@drawable/ic_home" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/atv_row2"
                                android:layout_width="match_parent"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/atv_mute"
                                    style="@style/AtvRound"
                                    android:layout_width="46dp"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="@string/key_mute"
                                    android:src="@drawable/ic_mute" />

                                <ImageView
                                    android:id="@+id/atv_vol_down"
                                    style="@style/AtvRound"
                                    android:layout_width="0dp"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@string/key_vol_down"
                                    android:src="@drawable/ic_vol_down" />

                                <ImageView
                                    android:id="@+id/atv_vol_up"
                                    style="@style/AtvRound"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@string/key_vol_up"
                                    android:src="@drawable/ic_vol_up" />
                            </LinearLayout>
                        </LinearLayout>
                        <!-- Tivibu page (Airties box, infrared): same box as the LG page -->
                        <LinearLayout
                            android:id="@+id/page_tivibu"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/tv_top"
                                android:layout_width="match_parent"
                                android:layout_height="30dp"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tv_power"
                                    style="@style/AtvRound"
                                    android:layout_width="30dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_tv_power"
                                    android:contentDescription="@string/key_power"
                                    android:padding="7dp"
                                    android:src="@drawable/ic_power" />

                                <TextView
                                    android:id="@+id/tv_menu"
                                    style="@style/TvKey"
                                    android:layout_marginEnd="6dp"
                                    android:text="@string/key_menu" />

                                <TextView
                                    android:id="@+id/tv_guide"
                                    style="@style/TvKey"
                                    android:layout_marginEnd="6dp"
                                    android:text="@string/key_guide" />

                                <ImageView
                                    android:id="@+id/tv_back"
                                    style="@style/AtvRound"
                                    android:layout_width="38dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@string/key_back"
                                    android:src="@drawable/ic_back" />

                                <TextView
                                    android:id="@+id/tv_numbers"
                                    android:layout_width="38dp"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_tv_toggle"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:contentDescription="@string/key_numbers"
                                    android:text="@string/key_numbers_short"
                                    android:textColor="@color/tv_toggle_text" />
                            </LinearLayout>

                            <!-- arrows and volume, or the number keys: never changes the card's size -->
                            <com.ahmadman.kenarpanel.FillFrame
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="8dp"
                                android:layout_weight="1">

                                <LinearLayout
                                    android:id="@+id/tv_nav"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical">

                                    <com.ahmadman.kenarpanel.TouchpadView
                                        android:id="@+id/tv_pad"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1" />

                                    <LinearLayout
                                        android:id="@+id/tv_row1"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_marginTop="8dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tv_ch_down"
                                            style="@style/TvKey"
                                            android:layout_marginEnd="6dp"
                                            android:contentDescription="@string/key_ch_down"
                                            android:text="@string/key_ch_down_short" />

                                        <TextView
                                            android:id="@+id/tv_info"
                                            style="@style/TvKey"
                                            android:layout_marginEnd="6dp"
                                            android:text="@string/key_info" />

                                        <TextView
                                            android:id="@+id/tv_ch_up"
                                            style="@style/TvKey"
                                            android:contentDescription="@string/key_ch_up"
                                            android:text="@string/key_ch_up_short" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/tv_row2"
                                        android:layout_width="match_parent"
                                        android:layout_height="28dp"
                                        android:layout_marginTop="6dp"
                                        android:orientation="horizontal">

                                        <ImageView
                                            android:id="@+id/tv_mute"
                                            style="@style/AtvRound"
                                            android:layout_width="46dp"
                                            android:layout_marginEnd="8dp"
                                            android:contentDescription="@string/key_mute"
                                            android:src="@drawable/ic_mute" />

                                        <ImageView
                                            android:id="@+id/tv_vol_down"
                                            style="@style/AtvRound"
                                            android:layout_width="0dp"
                                            android:layout_marginEnd="6dp"
                                            android:layout_weight="1"
                                            android:contentDescription="@string/key_vol_down"
                                            android:src="@drawable/ic_vol_down" />

                                        <ImageView
                                            android:id="@+id/tv_vol_up"
                                            style="@style/AtvRound"
                                            android:layout_width="0dp"
                                            android:layout_weight="1"
                                            android:contentDescription="@string/key_vol_up"
                                            android:src="@drawable/ic_vol_up" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/tv_keypad"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <LinearLayout style="@style/TvDigitRow">

                                        <TextView android:id="@+id/tv_d1" style="@style/TvDigit" android:text="@string/d1" />

                                        <TextView android:id="@+id/tv_d2" style="@style/TvDigit" android:text="@string/d2" />

                                        <TextView android:id="@+id/tv_d3" style="@style/TvDigit" android:layout_marginEnd="0dp" android:text="@string/d3" />
                                    </LinearLayout>

                                    <LinearLayout style="@style/TvDigitRow" android:layout_marginTop="5dp">

                                        <TextView android:id="@+id/tv_d4" style="@style/TvDigit" android:text="@string/d4" />

                                        <TextView android:id="@+id/tv_d5" style="@style/TvDigit" android:text="@string/d5" />

                                        <TextView android:id="@+id/tv_d6" style="@style/TvDigit" android:layout_marginEnd="0dp" android:text="@string/d6" />
                                    </LinearLayout>

                                    <LinearLayout style="@style/TvDigitRow" android:layout_marginTop="5dp">

                                        <TextView android:id="@+id/tv_d7" style="@style/TvDigit" android:text="@string/d7" />

                                        <TextView android:id="@+id/tv_d8" style="@style/TvDigit" android:text="@string/d8" />

                                        <TextView android:id="@+id/tv_d9" style="@style/TvDigit" android:layout_marginEnd="0dp" android:text="@string/d9" />
                                    </LinearLayout>

                                    <LinearLayout style="@style/TvDigitRow" android:layout_marginTop="5dp">

                                        <TextView
                                            android:id="@+id/tv_last"
                                            style="@style/TvDigit"
                                            android:contentDescription="@string/key_last"
                                            android:text="@string/key_last_short"
                                            android:textSize="12sp" />

                                        <TextView android:id="@+id/tv_d0" style="@style/TvDigit" android:text="@string/d0" />

                                        <TextView
                                            android:id="@+id/tv_ok"
                                            style="@style/TvDigit"
                                            android:layout_marginEnd="0dp"
                                            android:text="@string/key_ok"
                                            android:textSize="12sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.ahmadman.kenarpanel.FillFrame>
                        </LinearLayout>
                    </FrameLayout>

                </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- arrow tab: ‹ slides the remote away toward the app column, › brings it back -->
            <FrameLayout
                android:id="@+id/remote_fold"
                android:layout_width="26dp"
                android:layout_height="72dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_fold"
                android:clickable="true"
                android:contentDescription="@string/remote_hide"
                android:focusable="true">

                <!-- only the arrow turns, the tab stays put -->
                <ImageView
                    android:id="@+id/remote_fold_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_left"
                    android:tint="@color/panel_text" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.ahmadman.kenarpanel.PanelRoot>

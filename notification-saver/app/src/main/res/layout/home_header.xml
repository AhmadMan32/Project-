<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Shown until notification access is granted -->
    <LinearLayout
        android:id="@+id/setup"
        style="@style/Card"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <TextView
            style="@style/CardTitle"
            android:text="@string/setup_title"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="@string/setup_text"
            android:textColor="@color/text_secondary"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/setup_grant"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="@string/setup_grant" />

        <LinearLayout
            android:id="@+id/restricted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restricted_title"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/restricted_steps"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/restricted_open"
                style="@style/OutlineButton"
                android:layout_marginTop="12dp"
                android:text="@string/restricted_open" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live status -->
    <LinearLayout
        android:id="@+id/status"
        style="@style/Card"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/status_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_fix"
            style="@style/OutlineButton"
            android:layout_marginTop="12dp"
            android:text="@string/reconnect"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_box"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_search"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            android:tint="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/search_hint"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/open_all"
            style="@style/QuickTile"
            android:layout_marginEnd="6dp">

            <ImageView
                style="@style/QuickTileIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_list" />

            <TextView
                android:id="@+id/all_count"
                style="@style/QuickTileValue" />

            <TextView
                style="@style/QuickTileLabel"
                android:text="@string/all_notifications" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_deleted"
            style="@style/QuickTile"
            android:layout_marginStart="6dp">

            <ImageView
                style="@style/QuickTileIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_block"
                android:tint="@color/warn" />

            <TextView
                android:id="@+id/deleted_count"
                style="@style/QuickTileValue" />

            <TextView
                style="@style/QuickTileLabel"
                android:text="@string/deleted_messages" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/apps_label"
        style="@style/SectionLabel"
        android:text="@string/apps_label" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:padding="24dp"
        android:text="@string/empty_home"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>

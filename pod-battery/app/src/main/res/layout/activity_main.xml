<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Batteries -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="18dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/device"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <View
                        android:id="@+id/chip_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot_off" />

                    <TextView
                        android:id="@+id/chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.ahmadman.podpil.PodsView
                android:id="@+id/pods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/waiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:text="@string/waiting"
                android:textColor="@color/text_secondary"
                android:textSize="14.5sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/need_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/need_perm"
                    android:textColor="@color/text_secondary"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/grant"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/grant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bt_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_off"
                    android:textColor="@color/text_secondary"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/bt_enable"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/bt_enable" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/source_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/source_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/source_info"
                    style="@style/TextAction"
                    android:layout_height="36dp"
                    android:text="@string/why" />
            </LinearLayout>
        </LinearLayout>

        <!-- Estimate -->
        <LinearLayout
            android:id="@+id/estimate_card"
            style="@style/Card">

            <TextView
                android:id="@+id/est_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/est_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/est_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/est_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Details -->
        <LinearLayout
            android:id="@+id/details_card"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/details_title" />

            <LinearLayout
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Exact percent -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/exact_title" />

            <TextView
                android:id="@+id/exact_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/exact_explain"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/keys_enter"
                style="@style/OutlineButton"
                android:layout_marginTop="14dp"
                android:text="@string/keys_enter" />

            <TextView
                android:id="@+id/keys_clear"
                style="@style/TextAction"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/keys_clear"
                android:textColor="@color/battery_low" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/settings_title" />

            <Switch
                android:id="@+id/opt_popup"
                style="@style/Option"
                android:text="@string/opt_popup" />

            <TextView
                style="@style/OptionDesc"
                android:text="@string/opt_popup_desc" />

            <TextView
                android:id="@+id/test_popup"
                style="@style/TextAction"
                android:layout_marginStart="-12dp"
                android:text="@string/test_popup" />

            <TextView
                style="@style/Label"
                android:text="@string/opt_alert" />

            <LinearLayout
                android:id="@+id/seg_alert"
                style="@style/SegmentGroup" />

            <Switch
                android:id="@+id/opt_boot"
                style="@style/Option"
                android:layout_marginTop="10dp"
                android:text="@string/opt_boot" />
        </LinearLayout>

        <!-- Permissions -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:layout_marginBottom="0dp"
                android:text="@string/perm_title" />

            <LinearLayout
                android:id="@+id/permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/footer"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
